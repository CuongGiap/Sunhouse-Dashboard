# Authentication mode: oauth | service_account
GOOGLE_AUTH_MODE=oauth

# Google OAuth desktop app credentials JSON downloaded from Google Cloud Console
GOOGLE_CLIENT_SECRET_FILE=credentials.json

# Token file generated after first OAuth login
GOOGLE_TOKEN_FILE=token.json

# Service account credentials file (for cloud deploy). Ignored when GOOGLE_AUTH_MODE=oauth.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Optional inline JSON for service account (useful on cloud). Ignored when empty.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Default spreadsheet URL or ID (optional)
GOOGLE_SPREADSHEET=https://docs.google.com/spreadsheets/d/1JHwEsqYDE0gIC8osdnrmhnlhZtkRsf4_ZrBtPyOWRBk/edit#gid=0

# Cache TTL in seconds for sheet data refresh
CACHE_TTL_SECONDS=300
